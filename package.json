{
  "name": "stellar-nav",
  "version": "0.0.2",
  "description": "A high-performance, playful interstellar navigation simulator.",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/oxanium": "^0.4.2",
    "@expo/metro-runtime": "~57.0.8",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.10",
    "expo-blur": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-doctor": "^1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "postinstall": "setup-skia-web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "doctor": "expo-doctor",
    "audit": "pnpm --config.registry=https://registry.npmjs.org/ audit --prod --audit-level high",
    "check:boundaries": "node scripts/check-core-boundary.mjs",
    "check:release": "node --test scripts/release-config.test.mjs scripts/release-script.test.mjs scripts/release-workflow.test.mjs && node scripts/check-release-config.mjs",
    "prepare:android-release": "node scripts/configure-android-release-signing.mjs",
    "build:android-bundle": "expo export --platform android --output-dir .expo/android-export",
    "build:web": "expo export --platform web --output-dir dist",
    "check:bundle": "node scripts/check-web-bundle.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm check:release && pnpm test:coverage && pnpm run audit && pnpm doctor && pnpm build:android-bundle && pnpm build:web && pnpm check:bundle"
  },
  "engines": {
    "node": ">=22.13 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia"
    ],
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ],
    "overrides": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver",
    "testEnvironment": "@shopify/react-native-skia/jestEnv.js",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/data/**",
      "!src/design/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 65,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
